{
  "name": "QuickTill",
  "version": "0.2.2",
  "description": "Quick Till of Sale is a desktop application developed by Raedal Technologies",
  "author": "Raedal Technologies",
  "private": true,
  "main": "start.js",
  "build": {
    "appId": "quicktill.app",
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "target": "mas",
      "type": "distribution",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "category": "public.app-category.business",
      "icon": "iconbuilder.icns"
    },
    "linux": {
      "category": "Office",
      "icon": "assets/default.jpg"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/images/icon2.ico"
    },
    "files": [
      "**/*",
      "assets/**/*",
      "node_modules/**/*",
      "public/**/*"
    ]
  },
  "dependencies": {
    "async": "^3.2.6",
    "body-parser": "^2.3.0",
    "btoa": "^1.2.1",
    "dotenv": "^17.4.2",
    "electron-context-menu": "^4.1.2",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "electron-winstaller": "^5.4.4",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "html2canvas": "^1.4.1",
    "http": "0.0.0",
    "https": "^1.0.0",
    "is-port-reachable": "^4.0.0",
    "jquery": "^4.0.0",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "macaddress": "^0.5.4",
    "moment": "^2.30.1",
    "multer": "^2.2.0",
    "nedb": "^1.8.0",
    "notiflix": "^3.2.8",
    "path": "^0.12.7",
    "print-js": "^1.6.0",
    "socket.io": "^4.8.3",
    "stripe": "^22.5.0",
    "sweetalert2": "^11.26.25",
    "xmlhttprequest": "^1.8.0"
  },
  "scripts": {
    "electron": "cross-env NODE_ENV=dev nodemon --exec \"\"electron .\"\"",
    "electron-build": "electron-builder",
    "dist:mac": "electron-builder --mac --universal",
    "dist:linux": "electron-builder --linux",
    "package-win": "electron-builder --win",
    "package-win:nsis": "electron-builder --win nsis",
    "package-win:zip": "electron-builder --win zip"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1",
    "nodemon": "^3.1.14"
  }
}
